---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';

const allPosts = await getCollection('blog');

const categoryMap = new Map<string, { count: number; latestPost: any }>();

for (const post of allPosts) {
  const cat = post.data.category;
  if (!cat) continue;
  if (cat.includes('/')) {
    const parts = cat.split('/');
    for (let i = 0; i < parts.length; i++) {
      const subCat = parts.slice(0, i + 1).join('/');
      if (!categoryMap.has(subCat)) {
        categoryMap.set(subCat, { count: 0, latestPost: post });
      }
      const entry = categoryMap.get(subCat)!;
      entry.count++;
    }
  } else {
    if (!categoryMap.has(cat)) {
      categoryMap.set(cat, { count: 0, latestPost: post });
    }
    const entry = categoryMap.get(cat)!;
    entry.count++;
  }
}

const categories = Array.from(categoryMap.entries())
  .map(([name, info]) => ({
    name,
    displayName: name.split('/').pop()!,
    count: info.count,
    isCVE: name === 'CVE' || name.startsWith('CVE/'),
  }))
  .sort((a, b) => b.count - a.count);
---

<BlogLayout title="Categories Index">
  <div class="mb-8 pb-3 border-b border-slate-200 dark:border-slate-800 font-mono">
    <div class="flex items-center gap-2 text-xs text-sky-400 mb-1">
      <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
      <span>~/research/categories</span>
    </div>
    <div class="flex items-center justify-between flex-wrap gap-2">
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100 flex items-center gap-2.5">
        <span class="text-sky-400">&gt;</span>
        <span>Categories Directory</span>
      </h1>
      <span class="text-xs px-2.5 py-1 rounded-md bg-slate-900 text-sky-400 border border-sky-500/30">
        {categories.length} CATEGORIES
      </span>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 font-mono">
    {categories.map((cat) => (
      <a
        href={cat.isCVE ? '/cve' : `/categories/${encodeURIComponent(cat.name)}`}
        class={`card-hover rounded-xl p-5 group border transition-all duration-300 shadow-sm ${
          cat.isCVE
            ? 'bg-white/90 dark:bg-[#0b1324]/90 border-slate-200 dark:border-slate-800 hover:border-rose-500/50 hover:bg-rose-950/20'
            : 'bg-white/90 dark:bg-[#0b1324]/90 border-slate-200 dark:border-slate-800 hover:border-sky-500/50 hover:bg-sky-950/20'
        }`}
      >
        <div class="flex items-center justify-between mb-2">
          <span class={`text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded ${
            cat.isCVE ? 'bg-rose-950/60 text-rose-400 border border-rose-500/30' : 'bg-sky-950/60 text-sky-400 border border-sky-500/30'
          }`}>
            {cat.isCVE ? 'ADVISORY' : 'CTF'}
          </span>
          <span class="text-xs text-slate-400 group-hover:translate-x-0.5 transition-transform">
            &gt;
          </span>
        </div>
        <h2 class={`text-base font-bold transition-colors ${
          cat.isCVE ? 'text-slate-800 dark:text-slate-100 group-hover:text-rose-400' : 'text-slate-800 dark:text-slate-100 group-hover:text-sky-300'
        }`}>
          {cat.displayName}
        </h2>
        <p class="text-xs text-slate-400 dark:text-slate-500 mt-1 font-sans">
          {cat.count} {cat.count === 1 ? 'publication' : 'publications'}
        </p>
      </a>
    ))}
  </div>
</BlogLayout>
