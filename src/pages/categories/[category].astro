---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostList from '../../components/PostList.astro';
import { resolveCover } from '../_imageStore';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const categories = new Set<string>();
  for (const post of posts) {
    const cat = post.data.category;
    if (!cat) continue;
    categories.add(cat);
    if (cat.includes('/')) {
      const parts = cat.split('/');
      for (let i = 0; i < parts.length; i++) {
        categories.add(parts.slice(0, i + 1).join('/'));
      }
    }
  }
  return Array.from(categories).map((cat) => ({ params: { category: cat } }));
}

const { category } = Astro.params;
const allPosts = await getCollection('blog');

const filtered = allPosts
  .filter((post) => {
    const cat = post.data.category;
    if (!cat) return false;
    return cat === category || cat.startsWith(`${category}/`);
  })
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const postData = filtered.map((p) => ({
  ...p,
  slug: p.id,
  data: {
    ...p.data,
    cover: resolveCover('blog', p.id, p.data.cover),
  },
}));

const displayName = category!.split('/').pop()!;
const isCVE = category === 'CVE';

// Optional final scoreboard shown at the top of a CTF category page
const SCOREBOARDS: Record<string, { image: string; caption: string }> = {
  'SekaiCTF 2026': {
    image: '/ctf/sekaictf-2026-scoreboard.png',
    caption: 'Final scoreboard - #2 (team W4llz)',
  },
  'PTITCTF Quals 2026': {
    image: '/ctf/ptitctf-quals-2026-scoreboard.png',
    caption: 'Final scoreboard - #2 (team Kuramaa)',
  },
  'PTITCTF Finals 2026': {
    image: '/ctf/ptitctf-finals-2026-scoreboard.png',
    caption: 'Final Jeopardy - #10 (team Kuramaa)',
  },
  'SunshineCTF 2026': {
    image: '/ctf/sunshinectf-2026-rank.jfif',
    caption: 'Final scoreboard - 1st place (W4llz)',
  },
};
const scoreboard = SCOREBOARDS[category!];
---

<BlogLayout title={displayName}>
  <div class="mb-8 pb-3 border-b border-slate-200 dark:border-slate-800 font-mono">
    <div class="flex items-center gap-2 text-xs mb-1">
      <span class={`w-1.5 h-1.5 rounded-full ${isCVE ? 'bg-rose-400' : 'bg-sky-400'} animate-pulse`}></span>
      <span class="text-slate-400">~/research/category/</span>
      <span class={isCVE ? 'text-rose-400' : 'text-sky-400'}>{displayName}</span>
    </div>
    <div class="flex items-center justify-between flex-wrap gap-2">
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100 flex items-center gap-2.5">
        <span class={isCVE ? 'text-rose-400' : 'text-sky-400'}>&gt;</span>
        <span>{displayName}</span>
      </h1>
      <span class={`text-xs px-2.5 py-1 rounded-md border ${
        isCVE
          ? 'bg-rose-950/60 text-rose-400 border-rose-500/30'
          : 'bg-sky-950/60 text-sky-400 border-sky-500/30'
      }`}>
        {filtered.length} {isCVE ? 'ADVISORIES' : 'CHALLENGES'}
      </span>
    </div>
  </div>

  {
    scoreboard && (
      <figure class="mb-10 rounded-2xl overflow-hidden shadow-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0b1324]">
        <img
          src={scoreboard.image}
          alt={`${displayName} scoreboard`}
          class="w-full object-cover"
          loading="lazy"
        />
        <figcaption class="px-4 py-3 text-xs sm:text-sm font-mono text-slate-600 dark:text-slate-400 border-t border-slate-200 dark:border-slate-800 flex items-center gap-2 bg-slate-50 dark:bg-[#070b14]/60">
          <svg class="w-4 h-4 text-sky-400 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.4 6L14 4H5v17h2v-7h5.6l.4 2h7V6z"/>
          </svg>
          <span>{scoreboard.caption}</span>
        </figcaption>
      </figure>
    )
  }

  {
    category === 'PTITCTF Finals 2026' && (
      <section class="mb-10 font-sans">
        <p class="mb-4 text-sm sm:text-base text-slate-700 dark:text-slate-300">
          Đội mình vào được chung kết Attack - Defense và đạt được giải Ba chung cuộc.
        </p>
        <figure class="rounded-2xl overflow-hidden shadow-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0b1324]">
          <img
            src="/ctf/ptitctf-finals-2026-ad-top.png"
            alt="PTITCTF Finals 2026 Attack - Defense scoreboard"
            class="w-full object-cover"
            loading="lazy"
          />
          <figcaption class="px-4 py-3 text-xs sm:text-sm font-mono text-slate-600 dark:text-slate-400 border-t border-slate-200 dark:border-slate-800 flex items-center gap-2 bg-slate-50 dark:bg-[#070b14]/60">
            <svg class="w-4 h-4 text-sky-400 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M14.4 6L14 4H5v17h2v-7h5.6l.4 2h7V6z"/>
            </svg>
            <span>Attack - Defense final scoreboard - #6 (team Kuramaa)</span>
          </figcaption>
        </figure>
      </section>
    )
  }

  <PostList posts={postData} hideCover />
</BlogLayout>
