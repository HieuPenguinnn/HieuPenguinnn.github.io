---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostList from '../../components/PostList.astro';
import { resolveCover } from '../_imageStore';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const categories = new Set<string>();
  for (const post of posts) {
    const cat = post.data.category;
    if (!cat) continue;
    categories.add(cat);
    if (cat.includes('/')) {
      const parts = cat.split('/');
      for (let i = 0; i < parts.length; i++) {
        categories.add(parts.slice(0, i + 1).join('/'));
      }
    }
  }
  return Array.from(categories).map((cat) => ({ params: { category: cat } }));
}

const { category } = Astro.params;
const allPosts = await getCollection('blog');

const filtered = allPosts
  .filter((post) => {
    const cat = post.data.category;
    if (!cat) return false;
    return cat === category || cat.startsWith(`${category}/`);
  })
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const postData = filtered.map((p) => ({
  ...p,
  slug: p.id,
  data: {
    ...p.data,
    cover: resolveCover('blog', p.id, p.data.cover),
  },
}));

const displayName = category!.split('/').pop()!;

// Optional final scoreboard shown at the top of a CTF category page
const SCOREBOARDS: Record<string, { image: string; caption: string }> = {
  'SekaiCTF 2026': {
    image: '/ctf/sekaictf-2026-scoreboard.png',
    caption: 'Final scoreboard - #2 (team W4llz)',
  },
};
const scoreboard = SCOREBOARDS[category!];
---

<BlogLayout title={displayName}>
  <h1 class="text-2xl font-bold mb-8 flex items-center gap-2">
    <span class="w-1 h-6 bg-primary rounded-full inline-block"></span>
    {displayName}
    <span class="text-base font-normal text-gray-400">
      ({filtered.length} challenges)
    </span>
  </h1>
  {
    scoreboard && (
      <figure class="mb-10 rounded-2xl overflow-hidden shadow-sm ring-1 ring-gray-100 dark:ring-gray-800 bg-white dark:bg-[var(--color-card-dark)]">
        <img
          src={scoreboard.image}
          alt={`${displayName} scoreboard`}
          class="w-full"
          loading="lazy"
        />
        <figcaption class="px-4 py-3 text-sm text-gray-500 dark:text-gray-400 border-t border-gray-100 dark:border-gray-800 flex items-center gap-2">
          <svg class="w-4 h-4 text-primary" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.4 6L14 4H5v17h2v-7h5.6l.4 2h7V6z"/>
          </svg>
          {scoreboard.caption}
        </figcaption>
      </figure>
    )
  }
  <PostList posts={postData} hideCover />
</BlogLayout>
