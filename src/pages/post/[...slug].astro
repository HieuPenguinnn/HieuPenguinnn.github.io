---
import { getCollection, getEntry, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getReadingTime, getWordCount } from '../../utils/readingTime';
import { resolveCover } from '../_imageStore';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
  }));
}

const { slug } = Astro.params;
const post = await getEntry('blog', slug!);

if (!post) {
  return Astro.redirect('/404');
}

const coverSrc = resolveCover('blog', post.id, post.data.cover);

const { Content, headings } = await render(post);

const body = post.body || '';
const wordCount = getWordCount(body);
const readingTime = getReadingTime(body);

// Check if this is a CVE post
const cveMatch = post.data.title.match(/CVE-\d{4}-\d+/i);
const cveId = cveMatch ? cveMatch[0].toUpperCase() : null;
const isCVE = post.data.category === 'CVE' || Boolean(cveId);

const formattedDate = post.data.date
  ? new Date(post.data.date).toISOString().split('T')[0].replace(/-/g, '.')
  : '';

function getTagStyle(tag: string) {
  const lower = tag.toLowerCase();
  if (lower.includes('sql')) {
    return 'bg-red-950/60 text-red-400 border-red-500/40 hover:bg-red-900/50';
  }
  if (lower.includes('access control') || lower.includes('idor') || lower.includes('bac')) {
    return 'bg-amber-950/60 text-amber-400 border-amber-500/40 hover:bg-amber-900/50';
  }
  if (lower.includes('disclosure') || lower.includes('secret') || lower.includes('leak')) {
    return 'bg-sky-950/60 text-sky-400 border-sky-500/40 hover:bg-sky-900/50';
  }
  if (lower.includes('xss')) {
    return 'bg-fuchsia-950/60 text-fuchsia-400 border-fuchsia-500/40 hover:bg-fuchsia-900/50';
  }
  if (lower.includes('payment') || lower.includes('tamper') || lower.includes('price')) {
    return 'bg-orange-950/60 text-orange-400 border-orange-500/40 hover:bg-orange-900/50';
  }
  if (lower.includes('takeover') || lower.includes('auth') || lower.includes('rce')) {
    return 'bg-rose-950/60 text-rose-400 border-rose-500/40 hover:bg-rose-900/50';
  }
  if (lower.includes('wordpress')) {
    return 'bg-emerald-950/60 text-emerald-400 border-emerald-500/40 hover:bg-emerald-900/50';
  }
  return 'bg-slate-800/80 text-slate-300 border-slate-700 hover:bg-slate-700/80 hover:text-white';
}
---

<PostLayout title={post.data.title} description={post.data.description} headings={headings} cover={coverSrc}>
  
  <header class="mb-10 font-mono pb-6 border-b border-slate-200 dark:border-slate-800">
    
    <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-4 flex-wrap">
      <a href="/" class="hover:text-sky-400 transition-colors">~/research</a>
      <span class="text-slate-600">&gt;</span>
      {post.data.category && (
        <>
          <a href={isCVE ? '/cve' : `/categories/${encodeURIComponent(post.data.category)}`} class={`hover:underline ${isCVE ? 'text-rose-400' : 'text-sky-400'}`}>
            {post.data.category}
          </a>
          <span class="text-slate-600">&gt;</span>
        </>
      )}
      <span class="text-slate-400 dark:text-slate-500 truncate max-w-xs">{cveId || slug}</span>
    </div>

    <div class="flex flex-wrap items-center gap-2.5 mb-4">
      {cveId ? (
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md text-xs font-bold bg-rose-950/70 text-rose-400 border border-rose-500/50 shadow-[0_0_15px_-3px_rgba(244,63,94,0.35)]">
          <span class="w-1.5 h-1.5 rounded-full bg-rose-400 animate-pulse"></span>
          <span>{cveId}</span>
          <button
            type="button"
            id="cve-copy-header"
            class="ml-1 p-0.5 hover:text-white rounded transition-colors text-rose-300"
            data-cve={cveId}
            title={`Copy ${cveId}`}
            aria-label={`Copy ${cveId}`}
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            </svg>
          </button>
        </div>
      ) : post.data.category ? (
        <a
          href={`/categories/${encodeURIComponent(post.data.category)}`}
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-sky-400 bg-sky-950/60 border border-sky-500/40 px-3 py-1 rounded-md hover:bg-sky-900/50 transition-colors"
        >
          <span>&gt;</span> {post.data.category}
        </a>
      ) : null}

      {post.data.draft && (
        <span class="inline-flex items-center gap-1 text-xs text-slate-400 bg-slate-800 border border-slate-700 px-2.5 py-1 rounded-md">
          DRAFT
        </span>
      )}

      <div class="flex items-center gap-3 text-xs text-slate-400 ml-auto flex-wrap">
        {formattedDate && (
          <span class="flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
              <line x1="16" y1="2" x2="16" y2="6" />
              <line x1="8" y1="2" x2="8" y2="6" />
              <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
            {formattedDate}
          </span>
        )}
        <span>//</span>
        <span>~{readingTime} min read</span>
        <span>//</span>
        <span>{wordCount} words</span>
      </div>
    </div>

    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100 font-sans leading-tight mt-2 mb-4">
      {post.data.title}
    </h1>

    {post.data.tags && post.data.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mt-4 pt-3 border-t border-slate-200/50 dark:border-slate-800/60">
        {post.data.tags.map((tag: string) => (
          <a
            href={tag === 'CVE' ? '/cve' : `/tags/${encodeURIComponent(tag)}`}
            class={`text-xs px-2.5 py-0.5 rounded border transition-colors ${getTagStyle(tag)}`}
          >
            #{tag}
          </a>
        ))}
      </div>
    )}

  </header>

  <Content />

</PostLayout>

<script>
  function setupHeaderCopy() {
    const btn = document.getElementById('cve-copy-header');
    if (!btn) return;

    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      const cve = btn.getAttribute('data-cve');
      if (!cve) return;

      try {
        await navigator.clipboard.writeText(cve);
        const originalHTML = btn.innerHTML;
        btn.innerHTML =
          '<svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>';
        setTimeout(() => {
          btn.innerHTML = originalHTML;
        }, 2000);
      } catch (err) {
        console.error('Failed to copy CVE:', err);
      }
    });
  }

  setupHeaderCopy();
  document.addEventListener('astro:after-swap', setupHeaderCopy);
</script>
