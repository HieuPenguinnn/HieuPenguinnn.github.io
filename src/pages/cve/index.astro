---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import vulncheck from '../../data/vulncheck-cve.json';

// --- Patchstack: the detailed write-ups already published as blog posts ---
const cvePosts = (await getCollection('blog'))
  .filter((p) => p.data.category === 'CVE')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const PATCHSTACK_PUBLISHED = cvePosts.length; // 10 live write-ups
const PATCHSTACK_PENDING = 3; // reserved, not uploaded yet
const PATCHSTACK_TOTAL = PATCHSTACK_PUBLISHED + PATCHSTACK_PENDING;

// --- VulnCheck: the full advisory list (one entry per finding) ---
type VcEntry = {
  id: string;
  cves: string[];
  title: string;
  vendor: string;
  product: string;
  repo: string;
  cwes: string[];
  category: string;
  severity: string;
};
const vc = vulncheck as VcEntry[];

// light display cleanup — drop parentheticals / notes, keep it tight
const clean = (s: string) =>
  (s || '')
    .replace(/\s*[\(（][^)）]*[\)）]/g, '')
    .split(/\s*[\/,]\s*/)[0]
    .trim();

const vcCveIds = vc.reduce((n, e) => n + e.cves.length, 0);
const patchCount = cvePosts.length; // published Patchstack write-ups (10)
const grandTotalCves = vcCveIds + patchCount; // published CVE IDs across both

// One row per CVE ID — findings that got several CVEs are listed separately.
const vcRows = vc.flatMap((e) => e.cves.map((id) => ({ ...e, id })));

const sevCount = {
  critical: vcRows.filter((e) => e.severity === 'critical').length,
  high: vcRows.filter((e) => e.severity === 'high').length,
  medium: vcRows.filter((e) => e.severity === 'medium').length,
};

// category chips sorted by frequency (counted per CVE row)
const catMap = new Map<string, number>();
for (const e of vcRows) catMap.set(e.category, (catMap.get(e.category) ?? 0) + 1);
const categories = [...catMap.entries()].sort((a, b) => b[1] - a[1]);

const sevStyle: Record<string, string> = {
  critical: 'bg-rose-500/15 text-rose-400 border-rose-500/40',
  high: 'bg-orange-500/15 text-orange-400 border-orange-500/40',
  medium: 'bg-amber-500/15 text-amber-300 border-amber-500/40',
  low: 'bg-sky-500/15 text-sky-400 border-sky-500/40',
  '': 'bg-slate-500/10 text-slate-400 border-slate-600/40',
};

const cveUrl = (id: string) => `https://www.cve.org/CVERecord?id=${id}`;
---

<BlogLayout title="CVE Archive" description="CVEs discovered and disclosed by HieuPenguinnn across Patchstack and VulnCheck.">
  <div class="mb-8 pb-3 border-b border-slate-200 dark:border-slate-800 font-mono">
    <div class="flex items-center gap-2 text-xs mb-1">
      <span class="w-1.5 h-1.5 rounded-full bg-rose-400 animate-pulse"></span>
      <span class="text-slate-400">~/research/</span>
      <span class="text-rose-400">cve</span>
    </div>
    <div class="flex items-center justify-between flex-wrap gap-2">
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100 flex items-center gap-2.5">
        <span class="text-rose-400">&gt;</span>
        <span>CVE Archive</span>
      </h1>
      <span class="text-xs px-2.5 py-1 rounded-md bg-rose-950/60 text-rose-400 border border-rose-500/30">
        {grandTotalCves} CVE IDs
      </span>
    </div>
    <p class="mt-4 text-sm leading-relaxed text-slate-600 dark:text-slate-400 font-sans max-w-3xl">
      Vulnerabilities I found through source review and bug bounty, coordinated and disclosed via
      <span class="text-slate-800 dark:text-slate-200 font-medium">Patchstack</span> and
      <span class="text-slate-800 dark:text-slate-200 font-medium">VulnCheck</span>.
      Every entry below has a published CVE record.
    </p>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-12 font-mono">
    {[
      { k: grandTotalCves, l: 'Total CVEs', c: 'text-rose-400' },
      { k: vcCveIds, l: 'VulnCheck', c: 'text-emerald-400' },
      { k: patchCount, l: 'Patchstack', c: 'text-indigo-300' },
      { k: sevCount.critical, l: 'Critical', c: 'text-rose-400' },
    ].map((s) => (
      <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0b1324] px-4 py-3">
        <div class={`text-2xl font-extrabold ${s.c}`}>{s.k}</div>
        <div class="text-[11px] uppercase tracking-wider text-slate-400 mt-0.5">{s.l}</div>
      </div>
    ))}
  </div>

  <section class="mb-14">
    <div class="flex items-center justify-between flex-wrap gap-2 mb-5 font-mono">
      <h2 class="text-lg font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2.5">
        <span class="text-xs px-1.5 py-0.5 rounded bg-indigo-500/15 text-indigo-300 border border-indigo-500/30">0x01</span>
        Patchstack
      </h2>
      <a
        href="https://patchstack.com/database/researchers/ad4a020b-9889-4306-96fa-7049ee562b73"
        target="_blank" rel="noopener"
        class="text-xs text-indigo-300 hover:text-indigo-200 border border-indigo-500/30 hover:border-indigo-400/60 rounded-md px-2.5 py-1 transition-colors"
      >
        Patchstack profile ↗
      </a>
    </div>

    <div class="grid sm:grid-cols-2 gap-4">
      {cvePosts.map((post) => {
        const m = post.data.title.match(/CVE-\d{4}-\d+/i);
        const id = m ? m[0].toUpperCase() : '';
        const rest = post.data.title.replace(/^CVE-\d{4}-\d+\s*[-–:]\s*/i, '').trim();
        return (
          <a
            href={`/post/${post.id}`}
            class="group block rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0b1324] p-4 hover:border-rose-500/40 hover:shadow-lg hover:shadow-rose-950/20 transition-all"
          >
            <div class="flex items-center gap-2 mb-2">
              <span class="text-xs font-mono font-bold text-rose-400">{id}</span>
            </div>
            <div class="text-sm font-semibold text-slate-800 dark:text-slate-100 group-hover:text-rose-300 transition-colors leading-snug">
              {rest}
            </div>
            {post.data.description && (
              <p class="mt-2 text-xs text-slate-500 dark:text-slate-400 line-clamp-2 font-sans">
                {post.data.description}
              </p>
            )}
          </a>
        );
      })}
    </div>
  </section>

  <section>
    <div class="flex items-center justify-between flex-wrap gap-2 mb-5 font-mono">
      <h2 class="text-lg font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2.5">
        <span class="text-xs px-1.5 py-0.5 rounded bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">0x02</span>
        VulnCheck
      </h2>
    </div>

    <div class="mb-4 space-y-3 font-mono">
      <div class="relative">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          id="vc-search"
          type="search"
          placeholder="Filter"
          autocomplete="off"
          class="w-full pl-9 pr-3 py-2 text-sm rounded-lg bg-slate-100 dark:bg-slate-900/70 border border-slate-300 dark:border-slate-800 text-slate-700 dark:text-slate-200 placeholder:text-slate-400 focus:outline-none focus:border-emerald-500/50 transition-colors"
        />
      </div>
      <div class="flex flex-wrap gap-1.5" id="vc-chips">
        <button data-cat="all" class="vc-chip active text-xs px-2.5 py-1 rounded-md border transition-colors">All <span class="opacity-60">{vcRows.length}</span></button>
        {categories.map(([cat, n]) => (
          <button data-cat={cat} class="vc-chip text-xs px-2.5 py-1 rounded-md border transition-colors">{cat} <span class="opacity-60">{n}</span></button>
        ))}
      </div>
    </div>

    <div class="rounded-xl border border-slate-200 dark:border-slate-800 overflow-hidden bg-white dark:bg-[#0b1324]">
      <div id="vc-list" class="divide-y divide-slate-200 dark:divide-slate-800/70">
        {vcRows.map((e) => {
          const vendor = clean(e.vendor);
          const product = clean(e.product);
          const hay = (
            e.id + ' ' + e.vendor + ' ' + e.product + ' ' +
            e.category + ' ' + e.title + ' ' + e.cwes.map((c) => 'cwe-' + c).join(' ')
          ).toLowerCase();
          return (
            <div class="vc-row px-4 py-3 flex items-start gap-3 hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors" data-cat={e.category} data-hay={hay}>
              <span class={`shrink-0 mt-0.5 text-[10px] font-mono uppercase px-1.5 py-0.5 rounded border ${sevStyle[e.severity]}`}>
                {e.severity || 'n/a'}
              </span>
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                  <a href={cveUrl(e.id)} target="_blank" rel="noopener" class="text-xs font-mono font-bold text-rose-400 hover:text-rose-300 hover:underline">{e.id}</a>
                  <span class="text-[11px] font-mono px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-300/90 border border-emerald-500/20">{e.category}</span>
                  {e.cwes.slice(0, 3).map((c) => (
                    <span class="text-[10px] font-mono text-slate-400">CWE-{c}</span>
                  ))}
                </div>
                <div class="mt-1 text-sm text-slate-700 dark:text-slate-200 leading-snug">{e.title}</div>
                <div class="mt-1 text-[11px] font-mono text-slate-500 dark:text-slate-400">
                  {vendor}{product && vendor ? ' · ' : ''}{product}
                </div>
              </div>
            </div>
          );
        })}
      </div>
      <div id="vc-empty" class="hidden px-4 py-10 text-center text-sm font-mono text-slate-400">no advisories match your filter</div>
    </div>

    <div id="vc-pager" class="mt-5 flex items-center justify-center gap-1.5 font-mono"></div>
  </section>
</BlogLayout>

<style>
  .vc-chip {
    border-color: rgb(203 213 225 / 0.6);
    color: rgb(100 116 139);
  }
  :global(.dark) .vc-chip {
    border-color: rgb(30 41 59 / 0.9);
    color: rgb(148 163 184);
  }
  .vc-chip:hover {
    color: rgb(16 185 129);
    border-color: rgb(16 185 129 / 0.4);
  }
  .vc-chip.active {
    background: rgb(16 185 129 / 0.15);
    color: rgb(52 211 153);
    border-color: rgb(16 185 129 / 0.4);
  }
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<style is:global>
  #vc-pager .vc-page {
    min-width: 2.25rem;
    height: 2.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.6rem;
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 0.55rem;
    border: 1px solid rgb(203 213 225);
    background: rgb(255 255 255);
    color: rgb(51 65 85);
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.06);
    transition: color .15s, border-color .15s, background .15s;
  }
  .dark #vc-pager .vc-page {
    border-color: rgb(51 65 85);
    background: rgb(15 23 42);
    color: rgb(203 213 225);
    box-shadow: none;
  }
  #vc-pager .vc-page:hover:not(.disabled):not(.active) {
    color: rgb(16 185 129);
    border-color: rgb(16 185 129 / 0.55);
    background: rgb(16 185 129 / 0.08);
  }
  #vc-pager .vc-page.active {
    background: rgb(16 185 129);
    color: rgb(2 44 34);
    border-color: rgb(16 185 129);
    box-shadow: 0 0 14px -2px rgb(16 185 129 / 0.5);
  }
  #vc-pager .vc-page.disabled {
    opacity: 0.4;
    cursor: default;
    box-shadow: none;
  }
  #vc-pager .vc-dots {
    min-width: 1.5rem;
    text-align: center;
    color: rgb(100 116 139);
    font-size: 0.8rem;
    font-weight: 600;
  }
</style>

<script is:inline>
  var VC_PAGE_SIZE = 20;

  function setupCveFilter() {
    const search = document.getElementById('vc-search');
    const chips = Array.from(document.querySelectorAll('.vc-chip'));
    const rows = Array.from(document.querySelectorAll('.vc-row'));
    const emptyEl = document.getElementById('vc-empty');
    const pager = document.getElementById('vc-pager');
    const listEl = document.getElementById('vc-list');
    if (!search || !rows.length) return;

    let cat = 'all';
    let q = '';
    let page = 1;

    function matches(r) {
      const okCat = cat === 'all' || r.getAttribute('data-cat') === cat;
      const okQ = !q || (r.getAttribute('data-hay') || '').indexOf(q) !== -1;
      return okCat && okQ;
    }

    function renderPager(totalPages) {
      if (!pager) return;
      pager.innerHTML = '';
      if (totalPages <= 1) return;

      function btn(label, target, opts) {
        opts = opts || {};
        const b = document.createElement('button');
        b.textContent = label;
        b.className = 'vc-page' + (opts.active ? ' active' : '');
        if (opts.disabled) { b.disabled = true; b.className += ' disabled'; }
        else b.addEventListener('click', function () { page = target; apply(true); });
        pager.appendChild(b);
      }

      btn('‹', page - 1, { disabled: page === 1 });

      // windowed page numbers: first 3, last 2, and the current neighbourhood
      const win = [];
      const add = function (n) { if (n >= 1 && n <= totalPages && win.indexOf(n) === -1) win.push(n); };
      add(1); add(2); add(3);
      for (let i = page - 1; i <= page + 1; i++) add(i);
      add(totalPages - 1); add(totalPages);
      win.sort(function (a, b) { return a - b; });

      let prev = 0;
      for (const n of win) {
        if (n - prev > 1) {
          const dots = document.createElement('span');
          dots.textContent = '…';
          dots.className = 'vc-dots';
          pager.appendChild(dots);
        }
        btn(String(n), n, { active: n === page });
        prev = n;
      }

      btn('›', page + 1, { disabled: page === totalPages });
    }

    function apply(scroll) {
      const eligible = rows.filter(matches);
      const totalPages = Math.max(1, Math.ceil(eligible.length / VC_PAGE_SIZE));
      if (page > totalPages) page = totalPages;
      if (page < 1) page = 1;
      const start = (page - 1) * VC_PAGE_SIZE;
      const end = start + VC_PAGE_SIZE;

      // hide everything, then reveal current page slice of the eligible set
      for (const r of rows) r.classList.add('hidden');
      eligible.slice(start, end).forEach(function (r) { r.classList.remove('hidden'); });

      if (emptyEl) emptyEl.classList.toggle('hidden', eligible.length !== 0);
      renderPager(totalPages);

      if (scroll && listEl) {
        const top = listEl.getBoundingClientRect().top + window.scrollY - 90;
        window.scrollTo({ top: top, behavior: 'smooth' });
      }
    }

    search.addEventListener('input', function () {
      q = search.value.trim().toLowerCase();
      page = 1;
      apply(false);
    });

    chips.forEach(function (c) {
      c.addEventListener('click', function () {
        chips.forEach(function (x) { x.classList.remove('active'); });
        c.classList.add('active');
        cat = c.getAttribute('data-cat');
        page = 1;
        apply(false);
      });
    });

    apply(false);
  }

  setupCveFilter();
  document.addEventListener('astro:after-swap', setupCveFilter);
</script>
