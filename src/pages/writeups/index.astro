---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostList from '../../components/PostList.astro';
import { resolveCover } from '../_imageStore';

const allPosts = await getCollection('blog');

const filtered = allPosts
  .filter((post) => post.data.category !== 'CVE')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const postData = filtered.map((p) => ({
  ...p,
  slug: p.id,
  data: {
    ...p.data,
    cover: resolveCover('blog', p.id, p.data.cover),
  },
}));
---

<BlogLayout title="Write-up">
  <h1 class="text-2xl font-bold mb-8 flex items-center gap-2">
    <span class="w-1 h-6 bg-primary rounded-full inline-block"></span>
    Write-up
    <span class="text-base font-normal text-gray-400">
      ({filtered.length} posts)
    </span>
  </h1>
  <PostList posts={postData} hideCover />
</BlogLayout>
