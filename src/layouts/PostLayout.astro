---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface MarkdownHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  headings: MarkdownHeading[];
  cover?: string;
}

const { title, description, headings, cover } = Astro.props;
---

<BaseLayout title={title} description={description} ogType="article" image={cover}>
  {
    cover && (
      <div class="relative w-full h-64 sm:h-80 lg:h-96 overflow-hidden -mt-16 mb-8 border-b border-slate-800">
        <img
          src={cover}
          alt={title}
          class="w-full h-full object-cover filter contrast-105"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#f8fafc] dark:from-[#070b14] via-[#f8fafc]/50 dark:via-[#070b14]/60 to-transparent"></div>
        <div class="absolute inset-0 cyber-grid-pattern opacity-30 pointer-events-none"></div>
      </div>
    )
  }

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row gap-8 py-6">
      {
        headings && headings.length > 0 && (
          <aside class="w-full lg:w-64 shrink-0 order-1">
            <div class="sticky top-24">
              <TableOfContents headings={headings} />
            </div>
          </aside>
        )
      }
      <div class="flex-1 min-w-0 order-2">
        <article class="prose max-w-none">
          <slot />
        </article>
      </div>
      <div class="hidden xl:block w-12 shrink-0 order-3"></div>
    </div>
  </div>
</BaseLayout>
