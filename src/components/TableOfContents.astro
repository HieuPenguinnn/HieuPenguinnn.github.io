---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

const filtered = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
  filtered.length > 0 && (
    <nav class="rounded-2xl bg-white/90 dark:bg-[#0b1324]/90 border border-slate-200 dark:border-slate-800/80 p-5 shadow-lg shadow-slate-950/20 backdrop-blur-md font-mono">
      <div class="flex items-center justify-between mb-3 pb-2 border-b border-slate-200 dark:border-slate-800/80">
        <h2 class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider flex items-center gap-1.5">
          <span class="text-sky-400">&gt;</span> TABLE_OF_CONTENTS
        </h2>
        <span class="text-[10px] text-slate-400">INDEX</span>
      </div>
      <ul class="space-y-1.5 text-xs">
        {filtered.map((heading) => (
          <li>
            <a
              href={`#${heading.slug}`}
              class={`group flex items-start gap-1.5 py-1 text-slate-600 dark:text-slate-400 hover:text-sky-400 dark:hover:text-sky-300 transition-colors leading-snug ${
                heading.depth === 3 ? 'pl-4 text-[11px] text-slate-500' : 'font-medium'
              }`}
            >
              <span class="text-slate-400 dark:text-slate-600 group-hover:text-sky-400 transition-colors shrink-0">
                {heading.depth === 3 ? '└' : '#'}
              </span>
              <span class="truncate group-hover:underline decoration-sky-500/30">
                {heading.text}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
