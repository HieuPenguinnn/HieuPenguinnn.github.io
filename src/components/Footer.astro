---
import { getCollection } from 'astro:content';
import { SITE_TITLE, NAV_ITEMS, SITE_AUTHOR } from '../consts';
import { totalCveCount } from '../utils/cveStats';

const allBlogPosts = await getCollection('blog');
const totalArticles = allBlogPosts.length;

const cvePostCount = allBlogPosts.filter((p) => p.data.category === 'CVE').length;
const ctfCount = totalArticles - cvePostCount;
const cveCount = totalCveCount(cvePostCount);

const currentYear = new Date().getFullYear();
const startYear = 2026;
---

<footer class="relative mt-20 border-t border-slate-200/80 dark:border-slate-800/80 bg-white/50 dark:bg-[#070b14]/90 backdrop-blur-md font-mono text-xs">
  
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-sky-500/40 to-transparent"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
    
    <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-6 text-slate-500 dark:text-slate-400 mb-6">
      <div class="flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span>
        <span class="font-bold text-slate-700 dark:text-slate-300">{cveCount}</span> CVE Published
      </div>
      <span class="text-slate-300 dark:text-slate-700 select-none">/</span>
      <div class="flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
        <span class="font-bold text-slate-700 dark:text-slate-300">{ctfCount}</span> CTF Writeups
      </div>
      <span class="text-slate-300 dark:text-slate-700 select-none">/</span>
      <div class="flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        <span class="font-bold text-slate-700 dark:text-slate-300">{totalArticles}</span> Total Research Logs
      </div>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 text-slate-500 dark:text-slate-400 text-center">
      <span>
        &copy; {startYear}{currentYear > startYear ? ` - ${currentYear}` : ''}{' '}
        <a
          class="text-sky-400 hover:text-sky-300 font-bold hover:underline"
          href="https://github.com/HieuPenguinnn"
          target="_blank"
          rel="noopener noreferrer"
        >
          {SITE_AUTHOR}
        </a>
      </span>
      <span class="hidden sm:inline text-slate-300 dark:text-slate-700 select-none">|</span>
      <span>
        Powered by{' '}
        <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="text-slate-700 dark:text-slate-300 hover:text-sky-400 transition-colors">
          Astro
        </a>{' '}
        &amp;{' '}
        <a href="https://tailwindcss.com/" target="_blank" rel="noopener noreferrer" class="text-slate-700 dark:text-slate-300 hover:text-sky-400 transition-colors">
          Tailwind CSS
        </a>
      </span>
      <span class="hidden sm:inline text-slate-300 dark:text-slate-700 select-none">|</span>
      <span>
        Theme by{' '}
        <a href="https://github.com/santisify" target="_blank" rel="noopener noreferrer" class="text-amber-400 hover:underline">
          santisify
        </a>
      </span>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-4 mt-6 text-[11px] text-slate-400 dark:text-slate-500">
      {NAV_ITEMS.map((item) => (
        <a href={item.href} class="hover:text-sky-400 transition-colors">
          &gt; {item.label}
        </a>
      ))}
      <a href="/archives" class="hover:text-sky-400 transition-colors">
        &gt; Archives
      </a>
      <a href="/tags" class="hover:text-sky-400 transition-colors">
        &gt; Tags
      </a>
    </div>

  </div>
</footer>
