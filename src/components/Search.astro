<div id="search-modal" class="fixed inset-0 z-[100] hidden" aria-hidden="true">
  <div id="search-backdrop" class="absolute inset-0 bg-slate-950/80 backdrop-blur-md transition-opacity"></div>
  
  <div class="absolute top-[10%] sm:top-[15%] left-1/2 -translate-x-1/2 w-full max-w-2xl px-4">
    <div class="bg-[#0b1324] border border-slate-700/80 rounded-xl shadow-2xl shadow-sky-950/50 overflow-hidden font-mono">
      
      <div class="flex items-center justify-between px-4 py-2.5 bg-[#070b14] border-b border-slate-800">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-rose-500/80 border border-rose-600/50"></div>
          <div class="w-3 h-3 rounded-full bg-amber-500/80 border border-amber-600/50"></div>
          <div class="w-3 h-3 rounded-full bg-emerald-500/80 border border-emerald-600/50"></div>
          <span class="text-xs text-slate-400 ml-2 tracking-wide flex items-center gap-1.5">
            <span class="text-sky-400">&gt;</span> command_palette::search
          </span>
        </div>
        <kbd class="text-[10px] text-slate-400 bg-slate-800/80 border border-slate-700 px-1.5 py-0.5 rounded">
          ESC to exit
        </kbd>
      </div>

      <div class="flex items-center gap-2.5 px-4 py-3 border-b border-slate-800/80 bg-slate-900/40">
        <span class="text-emerald-400 text-sm select-none font-bold">➜</span>
        <span class="text-sky-400 text-xs select-none hidden sm:inline">~/research</span>
        <span class="text-slate-500 text-xs select-none hidden sm:inline">$</span>
        <input
          id="search-input"
          type="text"
          placeholder="Search CVE id, CTF, vulnerability type, or keywords..."
          class="flex-1 bg-transparent border-none outline-hidden text-sm text-slate-100 placeholder:text-slate-500 font-mono tracking-tight"
          autocomplete="off"
        />
        <button id="search-close" class="p-1 rounded text-slate-400 hover:text-slate-200 hover:bg-slate-800 transition-colors" aria-label="Close search">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <div id="search-results" class="max-h-96 overflow-y-auto p-2 divide-y divide-slate-800/40">
        <div class="px-4 py-8 text-center text-xs text-slate-500">
          <span class="text-sky-400">&gt;</span> Type a CVE identifier, CTF competition, or vuln class to query index...
        </div>
      </div>

      <div class="px-4 py-2 bg-[#070b14]/80 border-t border-slate-800 text-[11px] text-slate-500 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span><kbd class="bg-slate-800 px-1 py-0.5 rounded text-[10px] text-slate-300">↑↓</kbd> navigate</span>
          <span><kbd class="bg-slate-800 px-1 py-0.5 rounded text-[10px] text-slate-300">↵</kbd> select</span>
        </div>
        <div class="text-[10px] text-slate-400">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 mr-1 animate-pulse"></span>
          RESEARCH_INDEX_READY
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  let index: any[] | null = null;

  async function loadIndex() {
    if (index) return;
    try {
      const res = await fetch('/search-index.json');
      index = await res.json();
      const input = document.getElementById('search-input') as HTMLInputElement;
      if (input?.value) search(input.value);
    } catch {
      index = [];
    }
  }

  function openSearch() {
    const modal = document.getElementById('search-modal');
    if (!modal) return;
    modal.classList.remove('hidden');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    setTimeout(() => {
      document.getElementById('search-input')?.focus();
    }, 50);
    loadIndex();
  }

  function closeSearch() {
    const modal = document.getElementById('search-modal');
    if (!modal) return;
    modal.classList.add('hidden');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    const input = document.getElementById('search-input') as HTMLInputElement;
    if (input) input.value = '';
    const results = document.getElementById('search-results');
    if (results) {
      results.innerHTML = '<div class="px-4 py-8 text-center text-xs text-slate-500"><span class="text-sky-400">&gt;</span> Type a CVE identifier, CTF competition, or vuln class to query index...</div>';
    }
  }

  function search(query: string) {
    const results = document.getElementById('search-results');
    if (!results) return;

    if (!index) {
      results.innerHTML = '<div class="px-4 py-8 text-center text-xs text-slate-400"><span class="animate-pulse">Loading vulnerability database...</span></div>';
      return;
    }

    if (!query.trim()) {
      results.innerHTML = '<div class="px-4 py-8 text-center text-xs text-slate-500"><span class="text-sky-400">&gt;</span> Type a CVE identifier, CTF competition, or vuln class to query index...</div>';
      return;
    }

    const q = query.toLowerCase().trim();
    const terms = q.split(/\s+/);

    const filtered = index.filter((item: any) => {
      const haystack = [item.title, item.description, item.category, item.body, ...(item.tags || [])].join(' ').toLowerCase();
      return terms.every((term) => haystack.includes(term));
    }).slice(0, 20);

    if (filtered.length === 0) {
      results.innerHTML = '<div class="px-4 py-8 text-center text-xs text-rose-400 font-mono">[!] No matching advisories or CTF writeups found.</div>';
      return;
    }

    const highlightRe = new RegExp(`(${terms.map(t => escapeRegex(t)).join('|')})`, 'gi');

    results.innerHTML = filtered.map((item: any) => {
      const snippet = buildSnippet(item, terms);
      const isCVE = item.category === 'CVE' || (item.title && item.title.includes('CVE-'));
      
      return `
      <a href="/post/${item.slug}" class="flex items-start gap-3 p-3 rounded-lg hover:bg-slate-800/60 border border-transparent hover:border-slate-700/60 transition-all group">
        <div class="mt-0.5">
          ${isCVE 
            ? '<span class="inline-block text-[10px] font-mono font-bold text-rose-400 bg-rose-950/60 border border-rose-500/40 px-1.5 py-0.5 rounded">CVE</span>'
            : '<span class="inline-block text-[10px] font-mono font-bold text-sky-400 bg-sky-950/60 border border-sky-500/40 px-1.5 py-0.5 rounded">CTF</span>'
          }
        </div>
        <div class="flex-1 min-w-0">
          <div class="text-xs font-semibold text-slate-200 group-hover:text-sky-300 transition-colors line-clamp-1">
            ${highlight(item.title, highlightRe)}
          </div>
          ${snippet ? `<div class="text-[11px] text-slate-400 mt-1 line-clamp-2 leading-relaxed">${highlight(snippet, highlightRe)}</div>` : ''}
          <div class="flex items-center gap-2 mt-1.5">
            ${item.category ? `<span class="text-[10px] text-slate-400 font-mono">&gt; ${escapeHtml(item.category)}</span>` : ''}
            ${item.tags && item.tags.length > 0 ? `<span class="text-[10px] text-slate-400 font-mono">#${escapeHtml(item.tags.slice(0, 2).join(' #'))}</span>` : ''}
          </div>
        </div>
        <svg class="w-4 h-4 text-slate-600 group-hover:text-sky-400 transition-colors shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    `}).join('');
  }

  function buildSnippet(item: any, terms: string[]) {
    const text = (item.description || item.body || '');
    if (!text) return '';
    const lower = text.toLowerCase();
    for (const term of terms) {
      const idx = lower.indexOf(term);
      if (idx !== -1) {
        const start = Math.max(0, idx - 30);
        const end = Math.min(text.length, idx + term.length + 50);
        const snippet = text.slice(start, end);
        return (start > 0 ? '...' : '') + snippet + (end < text.length ? '...' : '');
      }
    }
    return text.slice(0, 90) + (text.length > 90 ? '...' : '');
  }

  function highlight(text: string, re: RegExp) {
    return escapeHtml(text).replace(re, '<mark class="bg-sky-500/25 text-sky-300 rounded-xs px-0.5">$1</mark>');
  }

  function escapeRegex(str: string) {
    return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  function escapeHtml(text: string) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  function onInput(e: Event) {
    search((e.target as HTMLInputElement).value);
  }

  function setup() {
    const input = document.getElementById('search-input') as HTMLInputElement;
    if (input) {
      input.removeEventListener('input', onInput);
      input.addEventListener('input', onInput);
    }

    const trigger = document.getElementById('search-trigger');
    if (trigger) {
      trigger.removeEventListener('click', openSearch);
      trigger.addEventListener('click', openSearch);
    }

    document.getElementById('search-close')?.addEventListener('click', closeSearch);
    document.getElementById('search-backdrop')?.addEventListener('click', closeSearch);

    // Global keyboard shortcut: Ctrl+K or Cmd+K
    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        const modal = document.getElementById('search-modal');
        if (modal?.classList.contains('hidden')) {
          openSearch();
        } else {
          closeSearch();
        }
      } else if (e.key === 'Escape') {
        closeSearch();
      }
    });
  }

  setup();
  document.addEventListener('astro:after-swap', setup);
</script>
