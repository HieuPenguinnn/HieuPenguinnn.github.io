---
import { SITE_TITLE, NAV_ITEMS } from '../consts';
import Search from './Search.astro';

function isArticleLabel(item: typeof NAV_ITEMS[number]) {
  return item.label === 'Posts';
}
---

<header class="sticky top-0 z-40 backdrop-blur-xl bg-white/80 dark:bg-[#070b14]/85 border-b border-slate-200/70 dark:border-slate-800/80 transition-all duration-300">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-8 h-8 rounded-lg bg-slate-900 border border-slate-700/70 dark:border-sky-500/30 flex items-center justify-center text-sky-400 group-hover:border-sky-400 group-hover:shadow-[0_0_15px_-3px_rgba(56,189,248,0.4)] transition-all">
          <span class="text-sm font-mono font-bold">&gt;_</span>
        </div>
        <div class="flex flex-col">
          <div class="flex items-center gap-1.5">
            <span class="text-base sm:text-lg font-bold font-mono tracking-tight text-slate-900 dark:text-slate-100 group-hover:text-sky-400 transition-colors">
              HieuPenguinnn
            </span>
            <span class="hidden sm:inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse" title="System Online"></span>
          </div>
          <span class="text-[10px] font-mono tracking-wider text-slate-400 dark:text-slate-500 uppercase -mt-1 hidden sm:block">
            Security Lab &amp; CTF
          </span>
        </div>
      </a>

      <nav class="hidden md:flex items-center gap-1.5" aria-label="Main navigation">
        {NAV_ITEMS.map((item) => (
          isArticleLabel(item) ? (
            <div class="relative group">
              <span class="px-3.5 py-1.5 text-xs font-mono font-medium rounded-lg text-slate-600 dark:text-slate-300 group-hover:text-sky-400 dark:group-hover:text-sky-400 group-hover:bg-slate-100 dark:group-hover:bg-slate-800/50 border border-transparent group-hover:border-slate-200 dark:group-hover:border-slate-700/60 transition-all cursor-pointer flex items-center gap-1.5">
                {item.label}
                <svg class="w-3 h-3 opacity-60 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
              <div class="absolute top-full left-0 mt-1 w-40 py-2 bg-white dark:bg-[#0d1527] rounded-xl shadow-xl border border-slate-200 dark:border-slate-800 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 backdrop-blur-md">
                <a href="/categories" class="block px-4 py-2 text-xs font-mono text-slate-600 dark:text-slate-300 hover:text-sky-400 hover:bg-sky-500/10 transition-colors">
                  &gt; Categories
                </a>
                <a href="/tags" class="block px-4 py-2 text-xs font-mono text-slate-600 dark:text-slate-300 hover:text-sky-400 hover:bg-sky-500/10 transition-colors">
                  &gt; Tags
                </a>
                <a href="/archives" class="block px-4 py-2 text-xs font-mono text-slate-600 dark:text-slate-300 hover:text-sky-400 hover:bg-sky-500/10 transition-colors">
                  &gt; Archives
                </a>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class={`px-3.5 py-1.5 text-xs font-mono font-medium rounded-lg border border-transparent transition-all ${
                item.label === 'CVE'
                  ? 'text-slate-600 dark:text-slate-300 hover:text-rose-400 dark:hover:text-rose-400 hover:bg-rose-500/10 hover:border-rose-500/20'
                  : item.label === 'Write-up'
                  ? 'text-slate-600 dark:text-slate-300 hover:text-sky-400 dark:hover:text-sky-400 hover:bg-sky-500/10 hover:border-sky-500/20'
                  : 'text-slate-600 dark:text-slate-300 hover:text-emerald-400 dark:hover:text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/20'
              }`}
            >
              {item.label}
            </a>
          )
        ))}
      </nav>

      <div class="flex items-center gap-2">
        
        <button
          id="search-trigger"
          class="flex items-center gap-2 px-2.5 py-1.5 sm:px-3 sm:py-1.5 rounded-lg bg-slate-100 dark:bg-slate-900/80 border border-slate-300 dark:border-slate-800 text-slate-500 dark:text-slate-400 hover:border-sky-500/50 hover:text-sky-400 transition-all text-xs font-mono group"
          aria-label="Search posts"
          title="Search advisories & writeups"
        >
          <svg class="w-4 h-4 text-slate-400 group-hover:text-sky-400 transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="hidden sm:inline text-slate-400 group-hover:text-slate-200">Search</span>
          <kbd class="hidden sm:inline-flex items-center gap-0.5 px-1.5 py-0.5 text-[10px] font-mono text-slate-400 dark:text-slate-400 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700/80 rounded shadow-xs">
            <span class="text-[9px]">Ctrl</span> K
          </kbd>
        </button>

        <button
          id="theme-toggle"
          class="p-2 rounded-lg text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800/70 border border-transparent hover:border-slate-200 dark:hover:border-slate-800 transition-colors"
          aria-label="Toggle theme"
        >
          <svg class="w-4 h-4 hidden dark:block text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg class="w-4 h-4 block dark:hidden text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <button
          id="mobile-menu-btn"
          class="md:hidden p-2 rounded-lg text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800/70 border border-transparent hover:border-slate-200 dark:hover:border-slate-800 transition-colors"
          aria-label="Menu"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden md:hidden pb-4 pt-2 border-t border-slate-200/50 dark:border-slate-800/60 font-mono">
      <nav class="flex flex-col gap-1.5">
        {NAV_ITEMS.map((item) => (
          <div>
            <a
              href={isArticleLabel(item) ? undefined : item.href}
              class={`block px-3 py-2 text-xs font-medium rounded-lg text-slate-600 dark:text-slate-300 hover:text-sky-400 hover:bg-sky-500/10 transition-colors ${
                isArticleLabel(item) ? 'cursor-pointer' : ''
              }`}
            >
              &gt; {item.label}
            </a>
            {isArticleLabel(item) && (
              <div class="ml-4 space-y-1 mt-1 border-l border-slate-700/50 pl-2">
                <a href="/categories" class="block px-3 py-1.5 text-xs text-slate-500 dark:text-slate-400 hover:text-sky-400 transition-colors">
                  └── Categories
                </a>
                <a href="/tags" class="block px-3 py-1.5 text-xs text-slate-500 dark:text-slate-400 hover:text-sky-400 transition-colors">
                  └── Tags
                </a>
                <a href="/archives" class="block px-3 py-1.5 text-xs text-slate-500 dark:text-slate-400 hover:text-sky-400 transition-colors">
                  └── Archives
                </a>
              </div>
            )}
          </div>
        ))}
      </nav>
    </div>
  </div>
</header>

<Search />

<script is:inline>
  function handleThemeToggle() {
    var root = document.documentElement;
    var isDark = root.classList.contains('dark');
    if (isDark) {
      root.classList.remove('dark');
      localStorage.theme = 'light';
    } else {
      root.classList.add('dark');
      localStorage.theme = 'dark';
    }
  }

  function handleMobileMenu() {
    var menu = document.getElementById('mobile-menu');
    if (menu) {
      menu.classList.toggle('hidden');
    }
  }

  function bindHandlers() {
    var themeBtn = document.getElementById('theme-toggle');
    var mobileBtn = document.getElementById('mobile-menu-btn');

    if (themeBtn) {
      themeBtn.removeEventListener('click', handleThemeToggle);
      themeBtn.addEventListener('click', handleThemeToggle);
    }

    if (mobileBtn) {
      mobileBtn.removeEventListener('click', handleMobileMenu);
      mobileBtn.addEventListener('click', handleMobileMenu);
    }
  }

  bindHandlers();

  document.addEventListener('astro:after-swap', function() {
    bindHandlers();
  });
</script>
