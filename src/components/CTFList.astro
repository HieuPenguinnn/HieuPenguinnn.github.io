---
import { getCollection } from 'astro:content';
import fs from 'node:fs';

const META: Record<string, { banner?: string; tag?: string }> = {
  "PTITCTF Quals 2026": { banner: "/ctf/banner-PTITCTF-2026.webp" },
  "PTITCTF Finals 2026": { banner: "/ctf/banner-PTITCTF-2026.webp" },
};

function bannerFor(cat: string): string | null {
  const m = META[cat]?.banner;
  if (m) return m;
  const guess = `/ctf/${cat.toLowerCase().replace(/\s+/g, '-')}.png`;
  return fs.existsSync(`public${guess}`) ? guess : null;
}

const allPosts = await getCollection('blog');

const counts = new Map<string, number>();
for (const p of allPosts) {
  const cat = p.data.category;
  if (!cat || cat === 'CVE') continue;
  const root = cat.split('/')[0];
  counts.set(root, (counts.get(root) || 0) + 1);
}

const ctfData = [...counts.entries()]
  .map(([cat, count]) => ({ cat, count, banner: bannerFor(cat), tag: META[cat]?.tag || "" }))
  .sort((a, b) => b.count - a.count);

const totalCtfChallenges = ctfData.reduce((acc, curr) => acc + curr.count, 0);
---

<section class="mb-12">
  <div class="flex items-center justify-between mb-6 pb-2.5 border-b border-slate-200/80 dark:border-slate-800/80 font-mono">
    <div class="flex items-center gap-2.5">
      <span class="w-2 h-2 rounded-full bg-sky-400 shadow-[0_0_10px_rgba(56,189,248,0.7)] animate-pulse"></span>
      <h2 class="text-lg sm:text-xl font-bold tracking-tight text-slate-900 dark:text-slate-100 flex items-center gap-2">
        <span>CTF Competitions</span>
        <span class="text-xs px-2 py-0.5 rounded bg-sky-950/60 text-sky-400 border border-sky-500/30">
          2026 SEASONS
        </span>
      </h2>
    </div>

    <a
      href="/writeups"
      class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold text-sky-400 hover:text-sky-300 transition-all group"
    >
      <span>All writeups ({totalCtfChallenges})</span>
      <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
      </svg>
    </a>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    {ctfData.map(({ cat, banner, tag, count }) => {
      const paddedCount = String(count).padStart(2, '0');
      return (
        <a
          href={`/categories/${encodeURIComponent(cat)}`}
          class="card-hover group relative overflow-hidden rounded-2xl bg-[#0b1324] border border-slate-200 dark:border-slate-800 hover:border-sky-400/60 hover:shadow-[0_0_25px_-5px_rgba(56,189,248,0.3)] transition-all duration-300 shadow-md block"
        >
          <div class="relative h-48 sm:h-52 overflow-hidden">

            {banner ? (
              <img
                src={banner}
                alt={cat}
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                loading="lazy"
              />
            ) : (
              <div class="w-full h-full bg-gradient-to-br from-slate-700 via-slate-800 to-[#0b1324] transition-transform duration-700 ease-out group-hover:scale-105"></div>
            )}

            <div class="absolute inset-0 bg-gradient-to-t from-[#070b14] via-[#070b14]/75 to-[#070b14]/25"></div>

            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-sky-400/15 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out pointer-events-none"></div>

            <div class="absolute top-3.5 right-3.5 flex items-center gap-2">
              {tag && (
                <span class="hidden sm:inline-block text-[10px] font-mono font-semibold text-slate-300 bg-slate-950/80 backdrop-blur-sm border border-slate-700/80 px-2 py-0.5 rounded">
                  {tag}
                </span>
              )}
              <span class="inline-flex items-center gap-1.5 text-xs font-mono font-bold text-sky-300 bg-[#070b14]/90 backdrop-blur-md px-2.5 py-1 rounded-md border border-sky-400/50 shadow-lg">
                <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
                [{paddedCount} PWNED]
              </span>
            </div>

            <div class="absolute bottom-0 left-0 right-0 p-4 sm:p-5 flex items-end justify-between">
              <div class="space-y-1">
                <div class="text-[10px] font-mono text-sky-400 uppercase tracking-widest flex items-center gap-1.5">
                  <span>FLAG DECRYPTED</span>
                  <span>//</span>
                  <span>WEB</span>
                </div>
                <h3 class="text-white font-bold text-lg sm:text-xl leading-tight group-hover:text-sky-300 transition-colors drop-shadow-md">
                  {cat}
                </h3>
                <p class="text-slate-400 text-xs font-mono font-normal">
                  {count} verified challenge {count === 1 ? 'solution' : 'solutions'}
                </p>
              </div>

              <span class="shrink-0 w-8 h-8 rounded-lg bg-sky-500/20 border border-sky-500/40 text-sky-300 flex items-center justify-center opacity-0 translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 shadow-md">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </span>
            </div>

          </div>
        </a>
      );
    })}
  </div>
</section>
