---
import PostCard from './PostCard.astro';

interface Post {
  id: string;
  slug: string;
  body: string;
  data: {
    title: string;
    description?: string;
    date: Date;
    tags?: string[];
    category?: string;
    cover?: string;
    pinned?: boolean;
    draft?: boolean;
  };
}

interface Props {
  posts: Post[];
  heading?: string;
  headingHref?: string;
  headingCount?: number;
  hideCover?: boolean;
  routePrefix?: string;
}

const { posts, heading, headingHref, headingCount, hideCover = false, routePrefix = '/post/' } = Astro.props;
const isCVE = heading === 'CVE';
---

{
  posts.length > 0 && (
    <section class="mb-12">
      {heading && (
        <div class="flex items-center justify-between mb-6 pb-2.5 border-b border-slate-200/80 dark:border-slate-800/80">
          <div class="flex items-center gap-2.5 font-mono">
            <span class={`w-2 h-2 rounded-full ${
              isCVE ? 'bg-rose-500 shadow-[0_0_10px_rgba(244,63,94,0.6)] animate-pulse' : 'bg-sky-400 shadow-[0_0_10px_rgba(56,189,248,0.6)]'
            }`}></span>
            <h2 class="text-lg sm:text-xl font-bold tracking-tight text-slate-900 dark:text-slate-100 flex items-center gap-2">
              <span>{isCVE ? 'Vulnerability Advisories' : heading}</span>
              {isCVE && (
                <span class="text-xs px-2 py-0.5 rounded bg-rose-950/60 text-rose-400 border border-rose-500/30">
                  CVE
                </span>
              )}
            </h2>
          </div>
          {headingHref && (
            <a
              href={headingHref}
              class={`inline-flex items-center gap-1.5 text-xs font-mono font-semibold transition-all group ${
                isCVE ? 'text-rose-400 hover:text-rose-300' : 'text-sky-400 hover:text-sky-300'
              }`}
            >
              <span>View all ({headingCount ?? posts.length})</span>
              <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
          )}
        </div>
      )}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {posts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            slug={post.slug}
            tags={post.data.tags}
            category={post.data.category}
            cover={post.data.cover}
            body={post.body}
            draft={post.data.draft}
            hideCover={hideCover}
            routePrefix={routePrefix}
          />
        ))}
      </div>
    </section>
  )
}
